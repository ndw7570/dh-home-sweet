# cp .env.example .env 후 값만 채운다.

DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# postgres | sqlite  (sqlite 는 스키마 없이 테이블명 접두어로 접혀서 뜬다 — 화면 확인용)
DB_ENGINE=postgres
DB_SCHEMA=trading_discipline_management
DB_NAME=trading_discipline
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

STRICT_QUERY_PARAMS=1
CORS_ALLOWED_ORIGINS=http://localhost:9070,http://127.0.0.1:9070
TIME_ZONE=Asia/Seoul
LOG_LEVEL=INFO

# ── KIS 오픈API (docs/kis-stack-plan.md) ──
# apiportal.koreainvestment.com 에서 발급. 모의(paper)와 실전(live)은 키가 별개다.
# 이 값들은 절대 커밋하지 않는다. .env 는 .gitignore 에 있어야 한다.
KIS_ENV=paper
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
# 초당 호출 허용치. 모의는 기본 2, 실전은 15. 넘기면 EGW00201 이 떨어진다.
# KIS_RATE_LIMIT_PER_SEC=2
